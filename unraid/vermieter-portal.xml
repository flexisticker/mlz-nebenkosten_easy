<?xml version="1.0"?>
<Container version="2">
  <Name>vermieter-portal</Name>
  <Repository>ghcr.io/flexisticker/mlz-nebenkosten-easy:latest</Repository>
  <Registry>https://github.com/flexisticker/mlz-nebenkosten_easy/pkgs/container/mlz-nebenkosten-easy</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Overview>Vermieter-Portal: Nebenkostenabrechnung, Dokumentenablage, Mietvertrag und Mieterhöhung für private Vermieter. Alle Daten bleiben im Datenordner auf dem Server. Keine Anmeldung, daher nur im Heimnetz betreiben.</Overview>
  <Category>Productivity:</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <Config Name="Web-Port" Target="8080" Default="8280" Mode="tcp" Description="Port im Heimnetz" Type="Port" Display="always" Required="true">8280</Config>
  <Config Name="Daten" Target="/data" Default="/mnt/user/appdata/vermieter-portal" Mode="rw" Description="Datenbank (portal.json), Dokumente und Sicherungen" Type="Path" Display="always" Required="true">/mnt/user/appdata/vermieter-portal</Config>
  <Config Name="Zeitzone" Target="TZ" Default="Europe/Berlin" Mode="" Description="" Type="Variable" Display="advanced" Required="true">Europe/Berlin</Config>
</Container>
